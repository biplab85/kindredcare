{
  "name": "kindredcare-home",
  "version": "0.1.0",
  "private": true,
  "description": "KindredCare marketing homepage — static build (SCSS + GSAP + Swiper + Fancybox)",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "scss": "sass src/scss/main.scss src/css/main.css --style=expanded --source-map --load-path=node_modules",
    "scss:watch": "npm run scss -- --watch",
    "serve": "browser-sync start --server src --no-notify --files \"src/**/*.html\" \"src/css/*.css\" \"src/js/**/*.js\"",
    "dev": "npm-run-all vendor --parallel scss:watch serve",
    "build": "npm-run-all vendor build:css build:copy",
    "build:css": "sass src/scss/main.scss src/css/main.css --style=compressed --no-source-map --load-path=node_modules && postcss src/css/main.css -o src/css/main.css",
    "build:copy": "node scripts/build.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "browser-sync": "^3.0.3",
    "cssnano": "^7.0.6",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "sass": "^1.83.0"
  },
  "dependencies": {
    "@fancyapps/ui": "^5.0.36",
    "gsap": "^3.12.5",
    "swiper": "^11.1.15"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
