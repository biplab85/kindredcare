# Playwright MCP scratch output (screenshots, snapshots, console logs).
# Browser screenshots land at the repo root under whatever name the run gave
# them, so ignore root-level PNGs. logo.png is already tracked and unaffected.
.playwright-mcp/
/*.png

# WordPress runtime logs. WP_DEBUG_LOG writes here on every local notice, so the
# file churns constantly and says nothing about the code.
wp-content/debug.log

# OS / editor
.DS_Store
Thumbs.db
